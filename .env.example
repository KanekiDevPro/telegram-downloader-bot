[TEMPLATE]
# ---------------------------------------------------------------------------
# Copy to .env and fill in. Keep comments on their own line:
# `KEY=   # note` is read as the *comment* by both python-dotenv and Docker
# Compose's env_file parser (the bot tolerates it, but it is a footgun).
# ---------------------------------------------------------------------------

# --- Telegram bot ----------------------------------------------------------
# From @BotFather.
BOT_TOKEN=
# Numeric Telegram ids, comma separated. Receipts are forwarded here.
ADMIN_IDS=
# polling (default) or webhook.
BOT_MODE=polling
# Only needed for BOT_MODE=webhook.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Infrastructure --------------------------------------------------------
# In Docker these are overwritten with the compose service names.
DATABASE_URL=postgresql://downloader:downloader@localhost:5432/downloader
REDIS_URL=redis://localhost:6379/0
# redis (default) or memory — memory needs no Redis at all.
QUEUE_BACKEND=redis
QUEUE_NAME=dl:tasks

# --- Downloader ------------------------------------------------------------
DOWNLOAD_DIR=downloads
# Also the per-file ceiling the worker enforces (see "Local Bot API" below).
MAX_FILE_SIZE_MB=2000
EXTRACTOR_TIMEOUT_S=90
DOWNLOAD_TIMEOUT_S=1800
# Extra attempts after a *retryable* failure — YouTube's stale session ("The
# page needs to be reloaded") is usually transient, so the retry happens before
# the user sees an error. Blocks are never retried: a flagged IP fails the same
# way every time. 0 disables retrying.
EXTRACTOR_RETRY_ATTEMPTS=2
# Base of the exponential backoff between those attempts (3s, then 6s, …).
EXTRACTOR_RETRY_BACKOFF_S=3.0
# Netscape cookie jar, relative to the project root. Needed for YouTube, and it
# only counts as a login when it carries LOGIN_INFO plus a SAPISID cookie
# (SAPISID / __Secure-1PAPISID / __Secure-3PAPISID). Without them yt-dlp sends
# anonymous requests and YouTube answers "Sign in to confirm you're not a bot";
# the bot and boot_check.py report exactly which cookies are missing.
#
# Docker reads this from a read-only mount instead (see COOKIES_HOST_DIR and the
# compose file), and re-checks it on every download: replacing the file is
# enough, no rebuild or restart.
COOKIE_FILE=cookies.txt
# compose only: the host *directory* mounted read-only at /cookies (the jar must
# be named cookies.txt inside it); compose then pins COOKIE_FILE to
# /cookies/cookies.txt. Point this at another directory to keep the jar outside
# the project. A directory is mounted instead of the file itself because a
# missing file mount makes Docker create a directory at that path and the
# container then refuses to start ("not a directory") — the state a fresh clone
# is in. With a directory source a missing jar is just one warning, and every
# site that does not need a login keeps working.
COOKIES_HOST_DIR=./
# How often the running bot checks whether a fresh export is still waiting, in
# seconds — and sends every admin one message per export, naming the mount, the
# age, and a warning when the new jar has no YouTube login (the failure that
# otherwise looks like a blocked IP). The jar present at startup is the
# baseline and never alerts, and a jar a download already took stays quiet. 0
# turns the watcher off; with no ADMIN_IDS it logs that it has nobody to tell.
COOKIE_WATCH_INTERVAL_S=60
# How often the two YouTube *helpers* are asked whether they are still alive, in
# seconds — the PO-token provider and the session server. A helper that dies at
# night is otherwise invisible until a user's link fails, and by then the only
# evidence is that link. One row per *change* goes to `helper_events` (so the
# table is a history, not a log), the admins are paged once a helper has been
# down for ten minutes and once more when it comes back (at most one page per
# helper per hour, so a flapping container cannot flood the chat), and the weekly
# digest gets a paragraph that says which helper was down, for how many hours and
# what it cost. Drift — a provider whose major version the plugin rejects, which
# answers every health check and mints nothing — counts as down, because the
# route is dead either way. All of it is local traffic to servers this stack
# runs, never an extraction, and nothing here can break a download. 0 turns the
# watch off.
HELPER_WATCH_INTERVAL_S=300
# Read cookies straight from a browser profile: BROWSER[+KEYRING][:PROFILE]
# (chrome, firefox, edge, brave, …). Only works when that profile is reachable
# from this process — for Docker, run scripts/export_cookies.py on the machine
# that has the browser and use COOKIE_FILE instead.
COOKIES_FROM_BROWSER=
# The mechanical half of the fix, done by the bot itself: after a download fails
# because YouTube treated the request as anonymous (and only for that failure),
# read the cookies out of this profile, replace the jar atomically, verify it
# with a metadata probe, and send the admins the verdict as one message. Same
# syntax as COOKIES_FROM_BROWSER. At most once per 30 minutes, and a candidate
# that lacks the YouTube login never overwrites a jar that has one — the refresh
# cannot lose a working login. Reachability is the catch: if this machine has no
# profile for that browser (a plain container), the attempt is skipped and the
# admins get the paths we looked at plus the command to run where the browser is.
# Empty = report the failure and leave the jar alone.
COOKIE_AUTO_EXPORT=
# JavaScript runtime yt-dlp uses to solve YouTube's player challenge. Without
# one, extraction is degraded ("some formats may be missing"). auto = first of
# deno/node/bun/qjs that is installed; also accepts none or node:/path/to/node.
YTDLP_JS_RUNTIME=auto
# Where yt-dlp may fetch the EJS challenge-solver scripts (its n/sig solver) from
# when the yt-dlp-ejs package does not carry them yet. Written exactly as yt-dlp
# spells it: ejs:github / ejs:npm (its --remote-components values — the dict form
# some docs show is silently discarded). Default ejs:github; empty = remote
# fetching off (the yt-dlp-ejs package alone serves). Fetched scripts are
# hash-checked by yt-dlp and cached in YTDLP_CACHE_DIR.
YTDLP_REMOTE_COMPONENTS=ejs:github
#
# ── What YouTube is allowed to see ──────────────────────────────────────────
#
# The tunnel changes the address; these two change what the request *claims to
# be*. YouTube's per-client bot checks are not equal, and yt-dlp's default for an
# anonymous session is `visionos` + `web` — where `web` is the client whose
# visitor binding produces "The page needs to be reloaded" (the SESSION_STALE
# this deployment meets most often).
#
# The list below is the token-free half of yt-dlp's own client table, with `web`
# last so the PO-token provider above still has its route; a refused token then
# costs the last client instead of every extraction.
#
# Measured from the installed yt-dlp (2026.08.19), not from the usual advice: in
# its client table `web`, `web_safari`, `mweb`, `android`, `android_vr`, `ios`
# and `tv_simply` all REQUIRE a GVS PO token, while `visionos`, `web_embedded`,
# `tv` and `tv_downgraded` do not. So `YTDLP_YOUTUBE_CLIENTS=android,ios,tv` is
# the *opposite* of a bypass here — those first two are the clients that demand
# the token. `/doctor` checks every name against the installed yt-dlp and names
# the ones it would skip or that need a token. Empty = let yt-dlp decide.
YTDLP_YOUTUBE_CLIENTS=visionos,web_embedded,tv_downgraded,web
# Force IPv4 for every yt-dlp connection — identical to `--force-ipv4`, which
# yt-dlp applies as a family filter in its own socket layer, so IPv6 candidates
# are never attempted rather than attempted and refused. On by default for the
# tunnel: Cloudflare WARP's IPv6 ranges are the ones YouTube flags hardest.
# Turn it off only if a source in the deployment has no IPv4 address at all.
YTDLP_FORCE_IPV4=1
# Log YouTube in with OAuth2 (`username: oauth2`), the Smart-TV device flow: an
# admin runs /oauth, opens the link, types the code, and yt-dlp caches the TV
# token (YTDLP_CACHE_DIR must be persistent — docker-compose mounts the yt-cache
# volume there, so the token survives recreations). TVs sit on datacenter/NAT
# addresses by the million, so this login is not hostage to browser-cookie
# rotation the way a jar is.
#
# Measured against the installed yt-dlp before you flip it: yt-dlp gained OAuth2
# in 2024.10.22 and YouTube later revoked the flow — current yt-dlp refuses
# `username=oauth2` outright ("Login with OAuth is no longer supported"), which
# /oauth will report instead of hanging. A reviving plugin installed into the
# mounted plugin directory (/app/config/yt-dlp) re-enables the flow, and this
# switch then works unchanged. Off by default: on stock yt-dlp it only buys the
# clear error.
YTDLP_USE_OAUTH2=0
# Where yt-dlp keeps its persistent cache (client ids, signatures, OAuth token).
# The compose file mounts the yt-cache volume at /app/cache; empty = yt-dlp's
# own default, which inside the container is ephemeral.
YTDLP_CACHE_DIR=/app/cache/yt-dlp
# Optional yt-dlp proxy, e.g. socks5://user:pass@host:1080. Worth setting only
# once the cookie jar actually logs you in — YouTube shows the same bot check
# for an anonymous session as for a flagged host.
#
# Measured on this stack, so the expectation is not a guess: with the proxy set,
# yt-dlp *did* use it (a deliberately bogus port fails with "Connection refused"
# instead of the bot check), and an ordinary cloud/datacenter exit changed
# nothing — that is exactly the kind of address YouTube's check is for. Which is
# why a cloud proxy is not a fix to buy: what the tunnel below does is leave from
# a *shared* WARP address that is not this host's own, which is free and often
# enough. A hard block still wants a residential exit, and the honest order of
# fixes stays: a jar that signs in, then that.
#
# One proxy here does not carry every helper: the PO-token provider mints its
# token through the same proxy when one is set (the bgutil plugin forwards it),
# cobalt has its own (COBALT_HTTP_PROXY → API_EXTERNAL_PROXY below), and the
# session generator takes no proxy *variable* at all — measured from its source,
# Chromium ignores HTTP(S)_PROXY. It is covered twice instead: it shares the
# tunnel container's network namespace (see the service in docker-compose.yml),
# and deploy/session_proxy/ is mounted into it as Python's `sitecustomize`, so
# the browser is also *told* to use the tunnel (`--proxy-server=…`) before it
# starts. That is deliberate: its token is bound to the public IP its browser ran
# on, so the browser has to leave from the same address the downloads do — and
# the two mechanisms cover the two WARP modes (a shared namespace routes
# everything while the client is in its default `warp` mode; the forced argument
# is what keeps the browser on the tunnel when the client is in WARP's proxy
# mode). What the browser actually did is written to runtime/browser-route.json
# and read back by /doctor, so "the server answers" and "its Chromium is on the
# tunnel" stop being the same sentence.
#
# A proxy running on this machine is `http://host.docker.internal:<port>`; the
# bot and cobalt containers resolve that name (docker-compose.yml declares it,
# which is also what makes it work on a Linux host and not only Docker Desktop).
YTDLP_PROXY=
#
# ── The tunnel this stack runs for you ──────────────────────────────────────
#
# docker-compose.yml starts a Cloudflare WARP container and hands the bot
# `http://warp:1080` *by default*, so a fresh deployment leaves YouTube through a
# shared WARP address rather than this host's own. That is the one free way off a
# datacenter IP YouTube has flagged, which is why nothing in this file has to be
# set for the tunnel to exist.
#
#   * to run *direct* (no tunnel at all): write `YTDLP_PROXY=` — the compose
#     default is deliberately written `${YTDLP_PROXY-http://warp:1080}` with a
#     single dash, so an explicitly empty value stays empty instead of being
#     replaced by the tunnel;
#   * to use your own proxy instead: `YTDLP_PROXY=socks5://user:pass@host:1080`
#     (PySocks is installed for it), or `http://host.docker.internal:<port>` for
#     a proxy running on this machine;
#   * a tunnel that is *down* is not a broken bot: the bot probes it at boot and
#     runs direct, with one log line, one admin notice and a /doctor row saying
#     so. It is also watched on a timer like the other helpers, so a tunnel that
#     dies at 3am becomes a recorded outage instead of a mystery for the next
#     user.
#
# How hard that boot probe tries before deciding the tunnel is down. WARP
# registers a few seconds after its container starts, so a single probe would
# call a tunnel that is merely still coming up "broken" — and every download in
# that window would leave from the address the tunnel exists to escape.
TUNNEL_PROBE_ATTEMPTS=6
TUNNEL_PROBE_DELAY_S=2
#
# compose-only (the bot does not read these):
#   WARP_LICENSE_KEY — a WARP+ / Zero Trust licence, which routes better than the
#     free tier on some hosts. Empty = free WARP, which is all this needs.
#   WARP_SLEEP — seconds the client waits before gost starts listening (2).
#   WARP_HTTP_PROXY — the tunnel URL the *cobalt-warp* instance is given; change
#     it only together with YTDLP_PROXY, so both engines still leave from the
#     same address (that shared exit is what makes one session token valid for
#     both).
#   YT_SESSION_CHROMIUM_PROXY — the proxy the session generator's Chromium is
#     forced through (default socks5://127.0.0.1:1080: inside its shared
#     namespace, 127.0.0.1 *is* the tunnel container). An explicitly empty value
#     means "run the browser direct".
#   YT_SESSION_PROXY_MODE — `auto` (force the proxy whenever it answers: default),
#     `always` (force it even if it does not), `never` (install nothing).
#   YT_SESSION_TRACE_URL — the trace endpoint the generator reads to learn whether
#     that namespace is tunnelled at all (default: Cloudflare's own).
#   RUNTIME_HOST_DIR — host directory holding the browser's route report
#     (default ./runtime), shared read-only with the bot.
# WARP_LICENSE_KEY=
# WARP_SLEEP=2
# WARP_HTTP_PROXY=
# YT_SESSION_CHROMIUM_PROXY=
# YT_SESSION_PROXY_MODE=
# YT_SESSION_TRACE_URL=
# RUNTIME_HOST_DIR=
#
# Concurrent download workers.
WORKER_COUNT=2


# --- Fallback extractor (Cobalt) -------------------------------------------
# The safety net for the one failure this host cannot fix: the *site* refusing
# our requests (a flagged IP, or a jar YouTube will not accept). yt-dlp stays
# the primary engine; a blocked link is handed to this instance instead of being
# answered with an error, and the user sees an ordinary download.
#
#   empty COBALT_API_URL = fallback off (a block behaves exactly as before)
#
# docker-compose.yml runs this instance next to the bot, so the default below
# works with no configuration at all — and it is the only default worth having:
# the public api.cobalt.tools retired its v7 endpoint and refuses anonymous
# callers (error.api.auth.jwt.missing), so pointing at it is a dead end.
#
# One setting, two addresses: `cobalt:9000` resolves inside the compose network,
# and the port is published on 127.0.0.1:9000 for a bot or script running on the
# host. Both are translated automatically (`core.config.probe_url`, which every
# helper in this file gets), so a host run needs nothing; a bare host with no
# Docker needs its own instance (ghcr.io/imputnet/cobalt).
#
# It shares this host's address, so it fixes a broken extractor, a site that
# refuses yt-dlp, and YouTube's per-client bot check — but NOT an IP YouTube has
# flagged. For that, give it a different way out (its own proxy, separate from
# YTDLP_PROXY):
#   COBALT_HTTP_PROXY=socks5h://user:pass@host:1080
#
# Only block-shaped failures are handed over (EXTRACTOR_BLOCKED, SESSION_STALE
# after its retries). A private video, an age-gated one or a live stream is the
# same answer from any address, so those still reach the user as a message.
#
# YouTube inside cobalt needs *a* cookie (cobalt has no login of its own), and it
# is generated from the jar above — one export signs both engines in:
#   cookies.txt (Netscape, yt-dlp)  ──▶  cobalt/cookies.json (what cobalt reads)
# That happens at startup and on every fresh export the watcher sees, so there is
# nothing to convert by hand. A signed-in jar gives cobalt the login; even an
# anonymous one is worth writing, because cobalt only retrieves YouTube's player
# (and its bot-check handling) when it has a cookie at all. For an IP that a login
# still does not satisfy there is a second, cookie-free route:
# YOUTUBE_SESSION_SERVER below.
#
# Cobalt reads the file ONCE, at startup, and writes its own refreshes back into
# it — so a new export needs `docker compose restart cobalt`, and /doctor says in
# one line whether the running instance has the version on disk.
#
# COBALT_API_KEY is sent as an `Authorization: Api-Key …` header, only when set.
# Both API shapes are spoken: the documented v7 request first, then the current
# v10 one (which moved the API to the instance root), remembering whichever
# answered. An instance that fails as an *instance* (auth, rate limit, 5xx,
# unreachable) is left alone for 10 minutes, so a fallback that cannot work costs
# one round trip and one log line, not one of each per blocked link.
#
# What the fallback does not give: titles are read off the downloaded file's own
# name, duration and thumbnails are unknown, and an album/playlist link stays
# refused (it is one file per request). A fallback success is still a success for
# the user — and the underlying yt-dlp failure is still recorded, so /blocks and
# /trend keep showing that the primary engine is degraded.
COBALT_API_URL=http://cobalt:9000
COBALT_API_KEY=

# ---------------------------------------------------------------------------
# The fallback POOL: what to try when the instance above cannot serve a link
# ---------------------------------------------------------------------------
#
# Why a pool and not just the embedded instance: that one runs on this host's
# address, so when YouTube has flagged the address it fails exactly the way
# yt-dlp did — a fallback that fails identically is not a fallback. The link is
# handed to the next address instead, which is often all it takes.
#
# Order is the design: COBALT_API_URL first (fast, local, private), then
# COBALT_FALLBACK_URLS in the order written (your own mirrors), and the official
# public instance (api.cobalt.tools) LAST — it may demand a key, it rate-limits
# anonymous callers, and every link handed to it leaves your network. Set
# COBALT_TRY_PUBLIC_INSTANCES=0 to keep everything internal, and blanking
# COBALT_API_URL switches the fallback off entirely (it will not silently reach
# for the public one instead).
#
# A node that fails as a *node* is set aside on its own for 10 minutes, and the
# node that answered last is asked first next time — so one instance that is
# down, or that simply has no YouTube session, cannot take the pool with it.
# More public instances live at https://instances.cobalt.best; paste the ones
# you trust below (a mirror comes and goes, which is why none are hard-coded).
COBALT_FALLBACK_URLS=
COBALT_TRY_PUBLIC_INSTANCES=1
# One round trip for the metadata resolve; the download gets its own, longer
# budget (it is a real transfer).
COBALT_TIMEOUT_S=30
COBALT_DOWNLOAD_TIMEOUT_S=1800
# Optional proxy for the fallback only — deliberately not inherited from
# YTDLP_PROXY, because a different path out is often the whole point. For the
# embedded instance this must be the cobalt *service*'s variable
# (COBALT_HTTP_PROXY), not this one.
COBALT_PROXY=
# What gives *cobalt itself* another way out. Compose hands this value to the
# cobalt container as API_EXTERNAL_PROXY, and that name is the whole point:
# cobalt ignores HTTP_PROXY/HTTPS_PROXY — its undici dispatcher never reads them
# — so a compose file that sets the familiar pair wires nothing at all. Measured
# both ways: with a bogus value here, cobalt answers "could not reach the source"
# instead of YouTube's answer (proof the setting arrived), and with a real cloud
# proxy it answers the same login error as without one — a different address is
# not the same as an acceptable one.
# COBALT_HTTP_PROXY=socks5h://user:pass@host:1080
COBALT_HTTP_PROXY=
# The host *directory* compose mounts into the cobalt service
# (COBALT_COOKIES_HOST_DIR, default ./cobalt) and into the bot. It holds
# `cookies.json` — the file cobalt reads — plus `generated.json`, which records
# when the content last changed so /doctor can compare it with the instance's own
# start time. Empty = generate nothing: the fallback then runs without a YouTube
# cookie, which still works for every other service it serves. Compose pins the
# container path (/app/cobalt) itself; this value is what a host run uses.
COBALT_COOKIES_DIR=cobalt
#
# The fallback's *cookie-free* route past YouTube's bot check. It is read by
# cobalt (not by the bot) and answers on GET /token with a po_token bound to this
# host's public IP — which is exactly what a flagged IP needs, and why it has to
# run on the same IP as the blocked host. docker-compose.yml runs it next to the
# bot, so the default needs no configuration:
#
#   docker compose logs yt-session-generator      # generates with a real browser
#   curl -s http://127.0.0.1:8080/token           # what cobalt reads (503 until ready)
#
# Know what it costs: the service runs Chromium under Xvfb, its first token can
# take a few minutes, and it cannot produce one on every host (the browser has to
# play a real YouTube embed from this IP). When it will not, /doctor says so
# instead of promising a session — the login jar above and the PO-token provider
# below are the other two routes, and both are independent of this one.
#
# Cobalt re-reads the server every 5 minutes on its own, so a fresh token needs no
# restart. Empty = the fallback runs without this route.
YOUTUBE_SESSION_SERVER=http://yt-session-generator:8080

# --- Language --------------------------------------------------------------
# What a *new* user gets. The bot speaks English and Persian, a user's own choice
# always wins, and it is stored per user in `users.language` — so this line decides
# only the first screen someone sees:
#   * a Telegram client set to Persian starts in Persian regardless of this value;
#   * `/language` (and the 🇬🇧 / 🇮🇷 buttons on /start) change it later, for good;
#   * anything that is not a known language falls back to "en", not to text no
#     catalogue has.
# One install, two audiences: nothing else in this file changes for a second one.
DEFAULT_LANGUAGE=en

# --- Menus -----------------------------------------------------------------
# What happens when a link's qualities cannot be discovered. Off (0, default):
# an explicit "not discovered" message with a retry that re-extracts - never a
# silent default download. On (1): one extra "best available" row, labelled as
# an automatic pick rather than an exact quality. Stale or expired menu taps
# get a re-extract / retry answer either way.
MENU_AUTO_BEST=0

# --- Limits ----------------------------------------------------------------
DEFAULT_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=60

# --- Manual card-to-card payment -------------------------------------------
MANUAL_CARD_NUMBER=
MANUAL_CARD_HOLDER=

# ---------------------------------------------------------------------------
# YouTube still says "Sign in to confirm you're not a bot"? (optional)
#
# First check COOKIE_FILE: a jar that is not logged in produces this message on
# any host, and an exporter that skipped the HTTP-only rows (LOGIN_INFO, the
# SAPISID family) leaves exactly that jar behind. The startup log names them.
#
# If the login is complete and the block persists, the IP is flagged. A PO-token
# provider makes requests look like a real player (a mitigation, not a fix) — and
# it is the one fix that needs no login at all:
#
#   YTDLP_POT_PROVIDER_URL=http://pot-provider:4416     # the default
#
# docker-compose.yml runs the provider next to the bot, so this works as shipped.
# It needs the bgutil-ytdlp-pot-provider plugin (requirements.txt installs it) and
# is unauthenticated, so its port is published on 127.0.0.1 only. A *residential*
# exit (YTDLP_PROXY) is the reliable fix for a flagged host; a cloud one is not,
# which is worth knowing before buying one — measured here, an Azure exit got the
# identical bot check.
#
# Two facts about that provider that /doctor reports in the same line: the plugin
# *rejects* a server whose major version differs from its own (the compose image
# is `:latest`, so that can drift after a `docker compose pull`), and a provider
# that is down costs every download its token rather than failing it — the bot
# drops the URL at startup only when the server really does not answer, and keeps
# going either way.
#
# The same no-login idea, wired for the *fallback* engine instead, is
# YOUTUBE_SESSION_SERVER above: one of the two is usually enough, and /doctor has
# a line for each. Neither helps against a hard IP block (YTDLP_PROXY is for
# that) — but neither needs a cookie.
#
# Not sure which one it is? Ask: /doctor in Telegram (admin only) or
#   python scripts/youtube_doctor.py            # --no-probe = offline
#
# Nobody has to ask, either: every failed download is stored with its cause, a
# run of login failures pages the admins within the hour (at most twice an hour),
# and /blocks in Telegram prints the 7-day breakdown — login vs IP vs the site.
# When COOKIE_AUTO_EXPORT is set, the first of those failures also triggers the
# re-export above, so the break is often over before anyone reads the alert.
#
# A helper that stops answering is a third thing, and nothing in a *user's* error
# would say so: HELPER_WATCH_INTERVAL_S above records it, pages on it and reports
# it in the same weekly digest.
#
# Nothing to fix, or the fix is not ready yet? COBALT_API_URL above is what
# keeps the *user* out of it: a link yt-dlp cannot get is fetched by another
# address altogether.
#
# From Telegram (all admin-only): /refresh [browser[:profile]] re-exports the jar
# on demand (no cooldown, names the profile without a restart), /fixlogin prints
# the guided way to a jar that really signs YouTube in — and
# scripts/fix_login.py walks it on the machine with the browser — and /trend
# shows the failures per day with the last fix marked, weighed by daily rates so
# "did the fix help?" has an answer that is not a guess.
# ---------------------------------------------------------------------------
YTDLP_POT_PROVIDER_URL=http://pot-provider:4416

# ---------------------------------------------------------------------------
# Local Telegram Bot API server (optional).
#
# The cloud API refuses bot uploads over 50 MB. Running your own
# telegram-bot-api raises the ceiling to 2000 MB (4 GB downloads in local
# mode). It needs TELEGRAM_API_ID and TELEGRAM_API_HASH from
# https://my.telegram.org → API development tools, and it is behind the
# `local-api` compose profile, so it only starts when you ask for it:
#
#   docker compose --profile local-api up -d --build
#
# With TELEGRAM_API_BASE_URL set but the server absent, the bot logs the
# failure and falls back to the cloud API (50 MB uploads) instead of dying.
# ---------------------------------------------------------------------------
TELEGRAM_API_BASE_URL=http://telegram-api:8081
# Set TELEGRAM_API_BASE_URL (above) to enable; 1 also serves files from disk.
TELEGRAM_API_LOCAL=1
