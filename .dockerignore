.venv/
__pycache__/
*.pyc
.env
downloads/
# The cookie jar is mounted read-only by docker-compose instead of being copied
# in: a baked jar would go stale behind the mount, and image layers are forever.
cookies.txt
.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
scripts/*
# The one script that belongs in the image: `install.sh diagnostics` runs
# `python scripts/boot_check.py` inside the bot container. The rest of
# scripts/ stays out — those tools run on the host (they read the checkout
# and the operator's browser). A bang cannot re-include a child of an
# excluded directory, so scripts/ is excluded per child, not wholesale.
!scripts/boot_check.py
deploy/
*.md
# The generated cobalt cookie file is a mounted volume, never an image layer
# (same reason as cookies.txt above).
cobalt/
